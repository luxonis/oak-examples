{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "oakctl: ensure placeholder",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cd ${workspaceFolder} && mkdir -p build && touch build/main_device"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "oakctl: start",
      "dependsOn": ["oakctl: ensure placeholder", "oakctl: prep", "oakctl: connect", "oakctl: app run", "oakctl: wait"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "oakctl: prep",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cd ${workspaceFolder} && mkdir -p .vscode build && printf \"BOARD_IP=%s\\n\" \"${input:boardIP}\" > .vscode/oak.env && cat > .vscode/oak.gdb <<EOF\ntarget remote ${input:boardIP}:5678\nremote get /app/build/main ${workspaceFolder}/build/main_device\nexec-file ${workspaceFolder}/build/main_device\n-enable-pretty-printing\nset substitute-path /app ${workspaceFolder}\nset pagination off\nEOF && touch build/main_device"
      ],
      "problemMatcher": []
    },
    {
      "label": "oakctl: connect",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cd ${workspaceFolder} && source .vscode/oak.env && oakctl -p ${input:oakPassword} connect $BOARD_IP"
      ],
      "problemMatcher": []
    },
    {
      "label": "oakctl: app run",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cd ${workspaceFolder} && source .vscode/oak.env && oakctl app run . -d $BOARD_IP -b"
      ],
      "problemMatcher": []
    },
    {
      "label": "oakctl: wait",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "sleep 10"
      ],
      "problemMatcher": []
    },
    {
      "label": "oakctl: app stop",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "cd ${workspaceFolder} && source .vscode/oak.env && oakctl app stop 00000000-0000-0000-0000-000000000000 -d $BOARD_IP"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "boardIP",
      "type": "promptString",
      "description": "Enter OAK board IP address",
      "default": "10.12.0.27"
    },
    {
      "id": "oakPassword",
      "type": "promptString",
      "description": "Enter OAK password"
    }
  ]
}
